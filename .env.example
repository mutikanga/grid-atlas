# Grid Atlas settings. ./atlas init copies this file to .env and replaces every
# CHANGE_ME with a random password. .env is never committed (.gitignore and the hook).
# Passwords: letters and digits only, because they go inside a database URL.

# Image tag for gridatlas-py and gridatlas-db (dev on the Mac; the release version on the server).
ATLAS_VERSION=dev
# dev on the Mac, server on the NCC VM (server refuses ./atlas reset and synthetic loads).
ATLAS_ENV=dev

# Database superuser, used only by first-boot init and ./atlas psql.
POSTGRES_PASSWORD=CHANGE_ME
# Worker role (atlas_rw): owns the schemas, runs loads and engine runs.
ATLAS_RW_PASSWORD=CHANGE_ME
# API role (atlas_ro): read-only, api.* views only.
ATLAS_RO_PASSWORD=CHANGE_ME

# Address the web port is published on: 127.0.0.1 on the Mac, the control-room address on the server.
ATLAS_BIND_IP=127.0.0.1
# Web port; 8090 avoids Grid Monitor's 8000/8100 and its proxy's 8080/8443.
ATLAS_HTTP_PORT=8090
# Who may open the Atlas: 0.0.0.0/0 in dev; the control-room subnet on the server (one CIDR).
ATLAS_ALLOW_CIDR=0.0.0.0/0
# Optional basic auth: leave empty for none, or /etc/nginx/auth/htpasswd after creating
# data/auth/htpasswd, e.g.  printf 'ncc:%s\n' "$(openssl passwd -apr1)" >> data/auth/htpasswd
ATLAS_AUTH_FILE=

# Internal network for db, worker, api (no route out). Must not overlap control-room or substation ranges.
ATLAS_CORE_SUBNET=172.30.90.0/28
# Nginx's network (masquerade off). Must not overlap control-room or substation ranges.
ATLAS_EDGE_SUBNET=172.30.90.16/28

# Memory limits per container (Grid Monitor shares the VM, keep these modest).
DB_MEM=768m
# Worker memory limit: load flows and loads run here.
WORKER_MEM=1536m
# API memory limit.
API_MEM=512m
# Nginx memory limit.
WEB_MEM=64m
# CPU limits per container (cores).
DB_CPUS=1.0
# Worker CPU limit (cores).
WORKER_CPUS=1.5
# API CPU limit (cores).
API_CPUS=1.0
# Nginx CPU limit (cores).
WEB_CPUS=0.25

# Worker start-up: synthetic = generate, load and run synthetic data into an empty database (dev); none on the server.
BOOTSTRAP=synthetic
# 1 lets the server load synthetic data (demo rehearsals only); 0 refuses it when ATLAS_ENV=server.
ALLOW_SYNTHETIC=0
